<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>teamdiff third-party licenses</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; color: #222; }
  pre { white-space: pre-wrap; background: #f4f4f4; padding: 1rem; font-size: 0.85rem; }
  li { margin: 0.2rem 0; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>teamdiff is built with the open-source crates below. Each license text lists the crates it covers.</p>
<ul>
{{#each overview}}
  <li>{{name}} ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2>{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
